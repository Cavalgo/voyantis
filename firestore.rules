rules_version = '2';

// MODO DEMO — reglas abiertas hasta 2026-09-28. NO es seguro para producción.
// Sin Auth: el acceso lo "controla" el PROFILE_ID fijo del cliente (ver mymds/rules.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if
          request.time < timestamp.date(2026, 9, 28);
    }
  }
}
